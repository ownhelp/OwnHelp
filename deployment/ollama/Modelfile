# Ollama import recipe for the fine-tuned Llama-3.2-3B-Instruct, Q4_K_M quantization
# (trained on retrieved-context data with hard negatives).
# Used by scripts/import_model.sh (`ollama create <OLLAMA_MODEL> -f Modelfile`) inside the
# model-init service; see deployment/README.md.
#
# FROM: the GGUF weights, resolved relative to this file. The import script mounts both files in
# the same directory, and verifies the GGUF SHA-256 before running `ollama create`.
FROM ./Llama-3.2-3B-Instruct.Q4_K_M.gguf

# Text-only branch of tokenizer.chat_template, including its fixed default date.
# The demo sends system/user text without tools. GGUF add_bos_token=true;
# do not insert a second explicit BOS here. No SYSTEM overrides the client prompt.
TEMPLATE """<|start_header_id|>system<|end_header_id|>

Cutting Knowledge Date: December 2023
Today Date: 26 July 2024

{{ .System }}<|eot_id|>{{ range .Messages }}{{ if ne .Role "system" }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>{{ end }}{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}"""

# Stop sequences: the GGUF EOS is token 128009 (<|eot_id|>); the other Llama 3 end markers are
# kept so generation never runs on into a new turn or leaks header tokens.
# num_ctx: context window in tokens (prompt plus retrieved chunks plus answer).
# temperature: low default for grounded answers; the chat service may override it per request
# from the tenant's agent_config.
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|eom_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER num_ctx 4096
PARAMETER temperature 0.2
