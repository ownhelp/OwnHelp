# Template for .env.compose.local, the private configuration read by compose.yaml (OwnHelp).
# Do not copy this file by hand: run scripts/setup_stack.py, which verifies the GGUF checksum and
# the Atlas URI format, then writes .env.compose.local (mode 0600) with fresh random secrets. It
# never overwrites an existing file. Values below are placeholders; never reuse them as secrets.
# Compose command: docker compose --env-file .env.compose.local up -d --wait
#
# Supplied by you to setup_stack.py (environment variable or hidden prompt): MONGODB_URI.
# Generated by setup_stack.py with random values: CHAT_BACKEND_TOKEN, CHAT_FOLLOW_UP_SECRET
# (each 64 hex characters).
# Generated with fixed defaults, editable afterwards: everything else, as listed here.

# =============================================================================================
# Database: your own MongoDB Atlas cluster (no database container runs in this stack)
# =============================================================================================
# REQUIRED. Atlas connection string; a credential. Percent-encode special characters in the
# password. Inference stays on this machine, but documents, embeddings, tickets and business
# records are stored in this cluster.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
# OPTIONAL (default rag_knowledge_base). Database name used by the gateway and chat service.
MONGODB_DB_NAME=rag_knowledge_base

# =============================================================================================
# Internal secrets (gateway and chat service)
# =============================================================================================
# REQUIRED. Shared secret between the gateway and the chat service.
CHAT_BACKEND_TOKEN=REPLACE_WITH_RANDOM_HEX
# REQUIRED. Stable secret for signing widget follow-up forms; keep it so outstanding forms survive restarts.
CHAT_FOLLOW_UP_SECRET=REPLACE_WITH_RANDOM_HEX

# =============================================================================================
# Local model (Ollama, on this machine)
# =============================================================================================
# REQUIRED. Absolute host directory containing Llama-3.2-3B-Instruct.Q4_K_M.gguf.
MODEL_GGUF_DIR=/absolute/path/to/external/hardneg_full01
# REQUIRED. Lowercase 64-character SHA-256 of that file; the model-init service refuses to import on mismatch.
MODEL_GGUF_SHA256=REPLACE_WITH_VERIFIED_SHA256
# OPTIONAL. Tag under which the model is registered in Ollama; the chat service requests this tag.
OLLAMA_MODEL=llama3.2:3b-qlora-hardneg-full01-q4
# OPTIONAL. Pinned Ollama image.
OLLAMA_IMAGE=ollama/ollama:0.40.16

# =============================================================================================
# Gateway and dashboard (host ports and browser-facing addresses, not Compose service names)
# =============================================================================================
# OPTIONAL. Host port for the gateway (bound to 127.0.0.1 only).
GATEWAY_PORT=4002
# OPTIONAL. Host port for the dashboard (bound to 127.0.0.1 only).
DASHBOARD_PORT=3002
# OPTIONAL. Gateway URL the dashboard's browser code calls; baked in at dashboard image build time.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4002
# OPTIONAL. Comma-separated origins the gateway accepts for dashboard requests; must include the dashboard URL.
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
# OPTIONAL. Name of the dashboard session cookie.
SESSION_COOKIE_NAME=ownhelp_session
