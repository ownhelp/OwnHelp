# ==============================================================================
# Client-training sandbox configuration (examples/client-training/.env.example)
# ==============================================================================
# OwnHelp sandbox: its own local MongoDB (offline), separate from the standard Atlas-based stack.
# This template documents every setting of the optional sandbox. You normally do not copy it:
# `bash examples/client-training/scripts/setup.sh` generates examples/client-training/.env.local
# on first run, with a random local MongoDB password. To configure by hand, copy this file to
# .env.local and edit it.
#
# Rules:
#   - .env.local is gitignored. Never commit it.
#   - Never put real MongoDB Atlas credentials or API keys here. The seeder refuses any
#     non-local MongoDB host, but keep this file free of real secrets anyway.
#   - Every value below is a local-only placeholder. "Required" means the stack will not
#     work without it; Compose and the code supply the shown default when it is omitted.
#   - These settings are separate from the repository root .env, which is never read.

# ------------------------------------------------------------------------------
# 1. Mode and database isolation
# ------------------------------------------------------------------------------
# Required. Must be exactly "preset_training": it enables the one-click preset login and
# makes the seeder and gateway use the training database.
APP_MODE="preset_training"
# Optional. The standard database name. The seeder refuses to write to it (and to capstone_dev),
# so a wrong value here cannot cause damage. Safe value: rag_knowledge_base.
MONGODB_DB_NAME="rag_knowledge_base"
# Required. Database that holds the synthetic tenants. The seeder only accepts "capstone_demo"
# or "capstone_local_demo".
MONGODB_TRAINING_DB_NAME="capstone_demo"
# Optional. Vector chunk collection. Safe value: doc_vectors.
MONGODB_COLLECTION_NAME="doc_vectors"

# ------------------------------------------------------------------------------
# 2. Local MongoDB Atlas (vector search) credentials and port
# ------------------------------------------------------------------------------
# Optional. Root user and password created by the mongodb-demo container on its first start.
# Use any local-only password (setup.sh generates "demo_" plus random hex). Changing the
# password after the first start needs `setup.sh reset`, because the volume keeps the old one.
DEMO_MONGO_USER="demo_admin"
DEMO_MONGO_PASSWORD="demo_local_only_password"
# Optional. Host loopback port for MongoDB (127.0.0.1 only).
DEMO_MONGO_PORT="27018"

# Required. URI used by the containers. The host must be "mongodb-demo" (the Compose service
# name) and the credentials must match DEMO_MONGO_USER / DEMO_MONGO_PASSWORD. The seeder
# accepts only mongodb:// URIs to 127.0.0.1, localhost or mongodb-demo, never mongodb+srv://.
MONGODB_URI="mongodb://demo_admin:demo_local_only_password@mongodb-demo:27017/?directConnection=true&authSource=admin"

# ------------------------------------------------------------------------------
# 3. Gateway and dashboard (loopback ports and browser session isolation)
# ------------------------------------------------------------------------------
# Optional. Host loopback ports for the gateway and dashboard (127.0.0.1 only).
DEMO_GATEWAY_PORT="4001"
DEMO_DASHBOARD_PORT="3001"
# Optional. Cookie name; the default differs from the standard stack so the two do not
# overwrite each other's login on localhost.
SESSION_COOKIE_NAME="ownhelp_demo_session"
# Optional. Directory inside the gateway container for uploads awaiting ingestion.
UPLOAD_STAGING_DIR="/tmp/ownhelp_demo_uploads"
# Required for browser logins. Comma-separated dashboard origins the gateway accepts. Must
# include http://localhost:<DEMO_DASHBOARD_PORT> if you change the dashboard port.
ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"
# Required. Gateway URL as the browser sees it. Baked into the dashboard image at build time,
# so rebuild (`setup.sh setup`) after changing it. Must match DEMO_GATEWAY_PORT.
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4001"

# ------------------------------------------------------------------------------
# 4. Embeddings and local inference
# ------------------------------------------------------------------------------
# Optional. 384-dimension embedding model; it must match the vector index. Safe value:
# BAAI/bge-small-en-v1.5.
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
# Optional. Ollama endpoint the containers call. Default targets Ollama on the host.
# `setup.sh setup --with-ollama` overrides it with http://ollama-demo:11434 for that run.
OLLAMA_HOST="http://host.docker.internal:11434"
# Optional. Model tag to call (and to download with `setup.sh pull-model`). Only live answer
# generation needs it; everything else works without a model.
OLLAMA_MODEL="llama3.2:3b"

# ------------------------------------------------------------------------------
# 5. Optional Compose-only overrides (not written by setup.sh; uncomment to use)
# ------------------------------------------------------------------------------
# Host loopback port for the bundled Ollama container (default 11435).
# DEMO_OLLAMA_PORT="11435"
# Shared secret between gateway-demo and chat-service-demo (default is a local-only placeholder).
# Any random string is a safe value; it never leaves the private Compose network.
# CHAT_BACKEND_TOKEN="change-me-to-a-random-local-string"
# Origins allowed to embed the widget when a tenant sets none. Empty (default) means reject.
# Example for local testing: http://localhost:8080
# WIDGET_DEFAULT_ALLOWED_ORIGINS=""
# Vector index name read by seed.py (default vector_index). Compose does not pass it to the
# containers, so it only matters when you run seed.py from the host.
# MONGODB_VECTOR_INDEX_NAME="vector_index"
