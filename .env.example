# OwnHelp: template for the local development .env (copy to .env; never commit .env).
# This file is for running the gateway, chat service and scripts directly on the host.
# The Docker Compose stack uses a different file: see .env.compose.example.
# Every value below is a placeholder or a safe local default. Never put real secrets in this file.
# Sections: 1 Database (REQUIRED), 2 Gateway, 3 Chat service and local model, 4 Research keys.
# Variables already exported in your shell take precedence over .env (see gateway/README.md).

# ---------------------------------------------------------------------------------------------
# 1. Database (MongoDB Atlas)                                        used by: gateway, chat service, ingest scripts
# ---------------------------------------------------------------------------------------------
# REQUIRED. Atlas connection string. Replace <username>, <password>, <cluster-url>; keep the real
# value only in your private .env. Scripts refuse to run while the placeholders are still present.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?
# OPTIONAL (default rag_knowledge_base). Database the gateway and chat service use at runtime:
# "rag_knowledge_base" for the final demo business, "capstone_dev" for the five mock tenants.
MONGODB_DB_NAME=rag_knowledge_base
# OPTIONAL (default capstone_dev). Database for development tenants; used by
# scripts/ingest_rag_docs.py when it ingests the five default mock tenants.
MONGODB_TRAINING_DB_NAME=capstone_dev
# OPTIONAL (default doc_vectors). Vector chunk collection. Keep the default unless you know why.
MONGODB_COLLECTION_NAME=doc_vectors
# OPTIONAL (default vector_index). Atlas Vector Search index name; must match the index definition.
MONGODB_VECTOR_INDEX_NAME=vector_index
# OPTIONAL (default BAAI/bge-small-en-v1.5, 384 dimensions). Embedding model. Changing it requires
# a 384-dimension model and re-ingesting every document.
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------------------------
# 2. Orchestration Gateway                                           used by: gateway (Node)
# ---------------------------------------------------------------------------------------------
# OPTIONAL (default standard). "standard" is the normal multi-tenant gateway; "preset_training"
# enables one-click synthetic demo tenants. For the self-contained Docker demo (no Atlas needed),
# see examples/client-training/README.md.
APP_MODE=standard
# OPTIONAL (default 4000). Gateway listen port.
# PORT=4000
# OPTIONAL (default ownhelp_session). Name of the dashboard session cookie. Any short identifier is fine.
# SESSION_COOKIE_NAME=ownhelp_session
# OPTIONAL. Directory where uploaded documents are staged before ingestion.
# UPLOAD_STAGING_DIR=/tmp/uploads
# OPTIONAL but recommended in production. Origins a browser page may embed the chat widget from, for
# tenants without their own widget_config.allowed_origins. Unset means "reject". The value below is
# a LOCAL DEVELOPMENT value; tenants should list their real origins on their business record.
WIDGET_DEFAULT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# OPTIONAL. Stable secret for widget follow-up forms. Use a long random value (for example the
# output of `openssl rand -hex 32`). Share it across gateway replicas; without it, outstanding
# forms expire when the gateway restarts.
# CHAT_FOLLOW_UP_SECRET=

# ---------------------------------------------------------------------------------------------
# 3. Chat service and local model (Ollama)       used by: scripts/run_chat_service.py, gateway
# ---------------------------------------------------------------------------------------------
# REQUIRED for chat. Name of an Ollama model that is already installed locally.
OLLAMA_MODEL=llama3.2:3b
# REQUIRED for chat (default http://localhost:11434). Address of the Ollama server.
OLLAMA_HOST=http://localhost:11434
# OPTIONAL (default http://127.0.0.1:8100). Where the gateway finds the internal chat service.
# CHAT_BACKEND_URL=http://127.0.0.1:8100
# OPTIONAL on one machine, REQUIRED if the chat service is reachable from another host. Shared
# secret the gateway presents to the chat service; use a long random value, not the placeholder.
# CHAT_BACKEND_TOKEN=change_me_when_the_service_is_reachable_from_another_host

# ---------------------------------------------------------------------------------------------
# 4. Optional research keys                      used by: src/evaluation and data generation only
# ---------------------------------------------------------------------------------------------
# OPTIONAL. Google Gemini key for teacher-model data generation and evaluation. Not needed to run
# the product. Calls are billed: keep the billed project key here, not a free-tier shell key.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# OPTIONAL. Hugging Face token, only needed for gated or private model downloads.
# HF_TOKEN=
